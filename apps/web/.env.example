# Local development settings. Copy to .env.local (git-ignored) and fill in.
# In production these come from /config.json, written by CDK at deploy time.

# Mock auth: no Cognito, no backend. Any email + password "Password1" signs in.
# See src/auth/mock.ts for the special test accounts.
VITE_MOCK_AUTH=false

# Real Cognito (values from the TrolleyStack outputs)
VITE_AWS_REGION=ap-southeast-2
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=

# Proxy /api to a deployed stack, e.g. https://dxxxxxxxx.cloudfront.net
VITE_API_PROXY=
